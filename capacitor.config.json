{
  "appId": "com.clearpathcapfunding.dealfit",
  "appName": "DealFit",
  "webDir": "docs",
  "server": {
    "androidScheme": "https"
  },
  "ios": {
    "contentInset": "never",
    "scrollEnabled": true
  },
  "android": {
    "allowMixedContent": false,
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "Keyboard": {
      "resize": "native",
      "style": "DARK",
      "resizeOnFullScreen": true
    },
    "StatusBar": {
      "style": "DARK",
      "overlaysWebView": true
    }
  }
}
